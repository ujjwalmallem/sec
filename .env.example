# IBKR Whale Options Scanner - Docker Environment Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_TYPE=postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=whale_scanner
POSTGRES_USER=whale_scanner
POSTGRES_PASSWORD=change_this_password_to_something_secure

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
FLASK_ENV=production
FLASK_DEBUG=0
WEB_HOST=0.0.0.0
WEB_PORT=5000
CONFIG_UI_PORT=5001

# =============================================================================
# DATA PROVIDER SELECTION
# =============================================================================
# Options: 'ibkr' or 'tradier'
# - ibkr: Requires TWS/Gateway running on host machine
# - tradier: Requires API key, no local TWS needed
DATA_PROVIDER=tradier

# =============================================================================
# INTERACTIVE BROKERS (IBKR) CONFIGURATION
# =============================================================================
# Required if DATA_PROVIDER=ibkr
# Note: TWS/Gateway must be running on your host machine
IBKR_HOST=host.docker.internal
IBKR_PORT=7497  # 7497 for paper, 7496 for live
IBKR_CLIENT_ID=1

# =============================================================================
# TRADIER API CONFIGURATION
# =============================================================================
# Required if DATA_PROVIDER=tradier
# Get your API key from: https://developer.tradier.com/
TRADIER_API_KEY=your_tradier_api_key_here
TRADIER_ACCOUNT_ID=your_tradier_account_id_here

# =============================================================================
# OPTIONAL: NOTIFICATION SETTINGS
# =============================================================================
# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio SMS Notifications (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# Email Alerts (optional)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_TO=recipient@example.com

# =============================================================================
# OPTIONAL: ADVANCED SETTINGS
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Scanner interval in seconds (when running scanner service)
SCAN_INTERVAL=60

# Max symbols to scan per run
MAX_SYMBOLS_PER_RUN=50

# Database path (for SQLite fallback only)
DATABASE_PATH=data/whale_scanner.db

# Log file path
LOG_FILE=logs/whale_scanner.log
